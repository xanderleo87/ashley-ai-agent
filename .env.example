# Copy this file to ".env" and fill in your own values.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=                 # auto-saved on first message

# --- Supabase (Postgres backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# --- Google OAuth ---
GOOGLE_EMAIL=you@example.com
GOOGLE_CREDENTIALS_FILE=credentials.json   # download from Google Cloud Console
GOOGLE_TOKEN_FILE=token.json               # generated on first auth

# --- App config ---
TIMEZONE=Asia/Manila
OAUTH_PORT=5050
OAUTH_BASE_URL=http://localhost:5050

# --- Apify (Google Maps lead scraping) ---
APIFY_API_KEY=
